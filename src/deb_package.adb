with Ada.Characters.Handling;
with Ada.Directories;
with Ada.Strings.Equal_Case_Insensitive;
with Ada.Strings.Fixed;
with Ada.Text_IO; use Ada.Text_IO;

with Alr2appimage_Config;

package body Deb_Package is

   use type String_Vectors.Vector; -- make "&" visible

   Sections : constant String_Vectors.Vector := String_Vectors.Empty_Vector &
      ("admin") &
      ("cli-mono") &
      ("comm") &
      ("database") &
      ("debug") &
      ("devel") &
      ("doc") &
      ("editors") &
      ("education") &
      ("electronics") &
      ("embedded") &
      ("fonts") &
      ("games") &
      ("gnome") &
      ("gnu-r") &
      ("gnustep") &
      ("graphics") &
      ("hamradio") &
      ("haskell") &
      ("httpd") &
      ("interpreters") &
      ("introspection") &
      ("java") &
      ("javascript") &
      ("kde") &
      ("kernel") &
      ("libdevel") &
      ("libs") &
      ("lisp") &
      ("localization") &
      ("mail") &
      ("math") &
      ("metapackages") &
      ("misc") &
      ("net") &
      ("news") &
      ("ocaml") &
      ("oldlibs") &
      ("otherosfs") &
      ("perl") &
      ("php") &
      ("python") &
      ("ruby") &
      ("rust") &
      ("science") &
      ("shells") &
      ("sound") &
      ("tasks") &
      ("tex") &
      ("text") &
      ("utils") &
      ("vcs") &
      ("video") &
      ("web") &
      ("x11") &
      ("xfce") &
      ("zope");

   procedure Put_Value
     (File : File_Type;
      Key, Value : String) is
   begin
      Put_Line (File, Key & ": " & Value);
   end Put_Value;

   procedure Put_Value
     (File : File_Type;
      Key : String;
      Value : Boolean) is
   begin
      Put_Line (File, Key & ": " &
                  Ada.Characters.Handling.To_Lower (Value'Image));
   end Put_Value;

   function Map_Char (C : Character) return Character
   is (if C = '_' then '-' else C);

   function Debian_Name_Of (Name : String) return String is
      Debian_Name : String := Name;
   begin
      Ada.Strings.Fixed.Translate (Debian_Name, Map_Char'Access);
      return Debian_Name;
   end Debian_Name_Of;
   function Debian_Architecture_Of (Arch : String) return String is
   begin
      if Arch = "aarch64" then
         return "arm64";
      elsif Arch = "arm" then
         -- The Debian architecture could be armel or armhf, we choose armhf as
         --  it is the most common one.
         return "armhf";
      elsif Arch = "i386" or else Arch = "i686" then
         return "i386";
      elsif Arch = "x86_64" then
         return "amd64";
      else
         return Arch;
      end if;
   end Debian_Architecture_Of;

   procedure Write_Control
     (App_Dir : String;
      Name : String;
      Comment : String;
      Exec : String;
      Maintainer : String;
      Version : String;
      Tags : String_Vectors.Vector;
      Dependencies : Ada.Strings.Unbounded.Unbounded_String :=
         Ada.Strings.Unbounded.Null_Unbounded_String;
      Include_Source : Boolean := False) is

      Control_File : File_Type;
      Section_Added : Boolean := False;
      Debian_Architecture : constant String :=
        Debian_Architecture_Of (Alr2appimage_Config.Alire_Host_Arch);
      Debian_Name : constant String := Debian_Name_Of (Name);
      Directory : constant String :=
         (if Include_Source
          then App_Dir & "/debian"
          else App_Dir & "/DEBIAN");
   begin

      Ada.Directories.Create_Path (Directory);
      Create (File => Control_File, Name => Directory & "/control");

      if Include_Source then
         Put_Value (Control_File, "Source", Debian_Name);
      end if;
      Put_Value (Control_File, "Package", Debian_Name);
      -- The "-1" is the debian_revision
      Put_Value (Control_File, "Version", Version & "-1");
      for Tag of Tags loop
         for Each_Section of Sections loop
            if Ada.Strings.Equal_Case_Insensitive (Each_Section, Tag) then
               Put_Value (Control_File, "Section", Each_Section);
               -- In Debian, the Section field is a single value, so we exit
               --  after the first match.
               Section_Added := True;
               exit;
            end if;
         end loop;
      end loop;
      if not Section_Added then
         Put_Value (Control_File, "Section", "misc");
      end if;
      Put_Value (Control_File, "Priority", "optional");
      Put_Value (Control_File, "Architecture", Debian_Architecture);

      if Ada.Strings.Unbounded.Length (Dependencies) > 0 then
         Put_Value
           (Control_File,
            "Depends",
            Ada.Strings.Unbounded.To_String (Dependencies));
      end if;

      Put_Value (Control_File, "Maintainer", Maintainer);
      Put_Value (Control_File, "Description", Comment);

      -- TODO: change for the long description, if any, in the alire.toml file.
      Put_Line (Control_File,
                  " Generated by alr2appimage from the crate '" & Name & "'.");

      Close (Control_File);

   end Write_Control;

end Deb_Package;
